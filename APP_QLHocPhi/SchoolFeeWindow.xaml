<Window x:Class="APP_QLHocPhi.SchoolFeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        WindowStartupLocation="CenterScreen"
        DataContext="{StaticResource SchoolFeeVM}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        x:Name="window"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Title="Quản lí học phí"
        Height="450"
        Width="1000">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <uc:UserControlBarUC Tag="{Binding Title, ElementName=window}"></uc:UserControlBarUC>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0"
                                     Margin="0 0 10 0"
                                     VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="10">
                            <TextBlock Text="DANH SÁCH CÔNG NỢ SINH VIÊN"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       VerticalAlignment="Center" />
                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Margin="10 0 0 0"
                                    Content="{materialDesign:PackIcon Kind=Refresh}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="10">
                            <TextBlock Text="DANH SÁCH CÔNG NỢ SINH VIÊN"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       VerticalAlignment="Center" />

                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Margin="10 0 0 0"
                                    Content="{materialDesign:PackIcon Kind=Refresh}" />

                            <Button Command="{Binding ResetCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Foreground="Red"
                                    BorderBrush="Red"
                                    Margin="10 0 0 0"
                                    ToolTip="Hủy toàn bộ lịch sử đóng tiền của SV này (Dùng để test lại)">
                                <materialDesign:PackIcon Kind="DeleteRestore" />
                            </Button>



                            <Button Command="{Binding RemoveCourseCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    Foreground="Green"
                                    BorderBrush="Green"
                                    Margin="10 0 0 0"
                                    ToolTip="Xóa sạch nợ (Coi như đã đóng đủ)">
                                <materialDesign:PackIcon Kind="CreditCardCheck" />
                            </Button>


                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ListStudentFee}"
                                  SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="All">
                            <DataGrid.Columns>
                                <materialDesign:DataGridTextColumn Binding="{Binding MSSV}"
                                                                   Header="MSSV" />
                                <materialDesign:DataGridTextColumn Binding="{Binding DisplayName}"
                                                                   Header="Họ Tên"
                                                                   Width="*" />
                                <materialDesign:DataGridTextColumn Binding="{Binding TongTienHoc, StringFormat=N0}"
                                                                   Header="Tổng Học Phí" />
                                <materialDesign:DataGridTextColumn Binding="{Binding DaDong, StringFormat=N0}"
                                                                   Header="Đã Đóng" />

                                <materialDesign:DataGridTextColumn Binding="{Binding ConNo, StringFormat=N0}"
                                                                   Header="CÒN NỢ"
                                                                   FontWeight="Bold"
                                                                   Foreground="Red" />

                                <materialDesign:DataGridTextColumn Binding="{Binding TrangThai}"
                                                                   Header="Trạng Thái" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1"
                                     Padding="15"
                                     VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN THANH TOÁN"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   HorizontalAlignment="Center"
                                   Margin="0 0 0 20" />

                        <TextBox Text="{Binding SelectedItem.DisplayName, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="Sinh viên đang chọn"
                                 IsReadOnly="True"
                                 Margin="0 10" />

                        <TextBox Text="{Binding SelectedItem.Lop, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="Lớp"
                                 IsReadOnly="True"
                                 Margin="0 10" />

                        <Separator Margin="0 10" />

                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Số Tiền Đóng (VNĐ)"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="Green"
                                 Margin="0 10" />

                        <TextBox Text="{Binding PaymentNote, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Ghi chú (Nội dung thu)"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0 10" />

                        <Grid Margin="0 20 0 0"
                              Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding PayCommand}"
                                    Content="TIỀN MẶT"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    materialDesign:ButtonAssist.CornerRadius="5 0 0 5"
                                    Margin="0 0 1 0"
                                    ToolTip="Thanh toán và in hóa đơn tiền mặt" />

                            <Button Grid.Column="1"
                                    Command="{Binding QRCommand}"
                                    Content="QUÉT QR"
                                    Background="#2196F3"
                                    BorderBrush="#2196F3"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="0 5 5 0"
                                    Margin="1 0 0 0"
                                    ToolTip="Tạo mã QR chuyển khoản ngân hàng" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</Window>
