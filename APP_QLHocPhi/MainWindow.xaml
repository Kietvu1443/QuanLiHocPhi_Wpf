<Window x:Class="APP_QLHocPhi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        DataContext="{StaticResource MainVM}"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="Phần mềm quản lí điểm"
        Height="450"
        Width="1000"
        Name="mainWindow">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <uc:UserControlBarUC Tag="{Binding Title, ElementName=mainWindow}"></uc:UserControlBarUC>
        </Grid>

        <Grid Grid.Row="1">
            <!--Phân chia layout chính-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--Thanh Submenu bar-->
            <Grid Grid.Column="0">
                <materialDesign:Card>
                    <TabControl materialDesign:ColorZoneAssist.Mode="Standard"
                                materialDesign:ElevationAssist.Elevation="Dp0"
                                Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto"
                                            Height="auto">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             Kind="ViewDashboard" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="Tổng Quan" />
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto"
                                            Height="auto">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             Kind="AccountSchool" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="Sinh Viên" />
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto"
                                            Height="auto">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             Kind="CashMultiple" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="Lệ Phí" />
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Width="auto"
                                            Height="auto">
                                    <materialDesign:PackIcon Width="24"
                                                             Height="24"
                                                             HorizontalAlignment="Center"
                                                             Kind="MusicBoxMultiple" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Text="Sounds" />
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                    </TabControl>
                </materialDesign:Card>
            </Grid>
            
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5">
    
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Danh sách sinh viên">
                    </TextBlock>
                    
                    <materialDesign:Badged Badge="{materialDesign:PackIcon AccountMultiplePlus}"
                                           BadgeColorZoneMode="SecondaryMid"
                                           HorizontalAlignment="Right">

                        <Button Content="Thêm sinh viên"
                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                    </materialDesign:Badged>
                </Grid>
                
                <Grid Grid.Row="1"
                      Margin="10">
              
                    <DataGrid Grid.Row="1"
                              Margin="10"
                              AutoGenerateColumns="False"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              ItemsSource="{Binding Items4}">

                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}"
                                                    Header="IsSelected"
                                                    Width="SizeToHeader" />

                            <DataGridTextColumn Binding="{Binding Code}"
                                                Header="STT" />

                            <DataGridTextColumn Binding="{Binding Name}"
                                                Header="MSSV" />

                            <DataGridTextColumn Binding="{Binding Description}"
                                                Header="Họ" />

                            <DataGridTextColumn Binding="{Binding Numeric}"
                                                Header="Tên" />

                            <DataGridTextColumn Binding="{Binding Food}"
                                                Header="Số tiền cần đóng" />

                            <DataGridTextColumn Binding="{Binding File}"
                                                Header="Đã thanh toán" />

                            <!-- đơn giản hoá VehicleType: dùng combo string -->
                            <DataGridComboBoxColumn Header="VehicleType"
                                                    SelectedItemBinding="{Binding VehicleType}"
                                                    ItemsSource="{Binding DataContext.VehicleTypes,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

           
            
        </Grid>
    </Grid>
</Window>
