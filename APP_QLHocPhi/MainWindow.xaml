<Window x:Class="APP_QLHocPhi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        DataContext="{StaticResource MainVM}"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="Phần mềm quản lí học phí"
        Height="450"
        Width="1000"
        Name="mainWindow">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <uc:UserControlBarUC Tag="{Binding Title, ElementName=mainWindow}"></uc:UserControlBarUC>
        </Grid>


        <Grid Grid.Row="1">
            <!--Phân chia layout chính-->
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Thanh Submenu bar-->


            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5">

                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Ứng dụng quản lí học phí"
                               HorizontalAlignment="Center">
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1"
                      HorizontalAlignment="Center">
                    <WrapPanel Background="Transparent"
                               Orientation="Horizontal"
                               Width="1000">

                        <WrapPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin"
                                        Value="10 10 10 10"></Setter>
                                <Setter Property="Width"
                                        Value="140"></Setter>
                                <Setter Property="Height"
                                        Value="100"></Setter>
                            </Style>
                        </WrapPanel.Resources>

                        <Button ToolTip="Tổng Quan"
                                Command="{Binding DashBoardCommand}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Tông Quan"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="ViewDashboard" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Quản lí Học Sinh"
                                Command="{Binding AddStudentCommand}"
                                Height="auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           TextWrapping="Wrap"
                                           Height="auto"
                                           TextAlignment="Center"
                                           Text="Quản lí học Sinh"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Kind="AccountSchool" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Quản Lí Học Phí"
                                Command="{Binding SchoolFeeCommand}"
                                Height="auto">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Quản lí học Phí"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="CashMultiple" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Học Sinh"
                                Command="{Binding StudentCommand}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Học Sinh"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="Account" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Người dùng"
                                Command="{Binding UserCommand}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Người dùng"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="Cog" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Thêm hoá đơn"
                                Command="{Binding UserCommand}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Thêm hoá đơn"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="Cog" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Xuất hoá đơn"
                                Command="{Binding UserCommand}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Xuất hoá đơn"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="Cog" />
                            </Grid>
                        </Button>
                    </WrapPanel>
                </Grid>

                <!--<Grid Grid.Row="1"
                      Margin="10">

                    <DataGrid Grid.Row="1"
                              Margin="10"
                              AutoGenerateColumns="False"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              ItemsSource="{Binding Items4}">

                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected}"
                                                    Header="IsSelected"
                                                    Width="SizeToHeader" />

                            <DataGridTextColumn Binding="{Binding Code}"
                                                Header="STT" />

                            <DataGridTextColumn Binding="{Binding Name}"
                                                Header="MSSV" />

                            <DataGridTextColumn Binding="{Binding Description}"
                                                Header="Họ" />

                            <DataGridTextColumn Binding="{Binding Numeric}"
                                                Header="Tên" />

                            <DataGridTextColumn Binding="{Binding Food}"
                                                Header="Số tiền cần đóng" />

                            <DataGridTextColumn Binding="{Binding File}"
                                                Header="Đã thanh toán" />

                            -->
                <!-- đơn giản hoá VehicleType: dùng combo string -->
                <!--
                            <DataGridComboBoxColumn Header="VehicleType"
                                                    SelectedItemBinding="{Binding VehicleType}"
                                                    ItemsSource="{Binding DataContext.VehicleTypes,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGrid.Columns>
                    </DataGrid>-->
                <!--</Grid>-->
            </Grid>
        </Grid>
    </Grid>
</Window>
