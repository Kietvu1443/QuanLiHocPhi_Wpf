<Window x:Class="APP_QLHocPhi.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        WindowStartupLocation="CenterScreen"
        DataContext="{StaticResource StudentVM}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        x:Name="window"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Title="Quản lí học phí"
        Height="450"
        Width="850">
    <Grid>
      <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
          
            <Grid Grid.Row="0">
                <uc:UserControlBarUC Tag="{Binding Title, ElementName=window}"></uc:UserControlBarUC>
            </Grid>
          
            <Grid Grid.Row="1">
                <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           Margin="10"
                           Text="Đăng kí môn học" />
            </Grid>
                
            <materialDesign:Card Grid.Row="2"
                                 Margin="10"
                                 Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0"
                               Margin="0 0 0 15">
                        <ComboBox ItemsSource="{Binding StudentList}"
                                  SelectedItem="{Binding SelectedStudent}"
                                  DisplayMemberPath="DisplayName"
                                  materialDesign:HintAssist.Hint="Chọn Sinh Viên"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  Width="200"
                                  Margin="5" />

                        <ComboBox ItemsSource="{Binding SemesterList}"
                                  SelectedItem="{Binding SelectedSemester}"
                                  DisplayMemberPath="HocKy"
                                  materialDesign:HintAssist.Hint="Chọn Học Kỳ"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  Width="150"
                                  Margin="15 5 5 5" />

                        <ComboBox ItemsSource="{Binding SubjectList}"
                                  SelectedItem="{Binding SelectedSubject}"
                                  DisplayMemberPath="DisplayName"
                                  materialDesign:HintAssist.Hint="Chọn Môn Học"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  Width="200"
                                  Margin="15 5 5 5" />

                        <Button Command="{Binding AddTempCommand}"
                                Content="Thêm Môn"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="20 0 0 0" />
                    </WrapPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Command="{Binding DeleteTempCommand}"
                                Content="Xóa dòng chọn"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="OrangeRed"
                                BorderBrush="OrangeRed"
                                Margin="5" />

                        <Button Command="{Binding ExportCommand}"
                                Content="Xuất Danh Sách"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="5" />

                        <Button Command="{Binding ConfirmCommand}"
                                Content="XÁC NHẬN ĐĂNG KÝ"
                                Background="Green"
                                BorderBrush="Green"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="40"
                                Margin="5" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3"
                                 Margin="10"
                                 VerticalAlignment="Stretch">
                <DataGrid ItemsSource="{Binding ListDangKy}"
                          CanUserAddRows="False"
                          AutoGenerateColumns="False"
                          HeadersVisibility="All"
                          SelectionUnit="FullRow"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                    <DataGrid.Resources>
                        <Style TargetType="CheckBox"
                               BasedOn="{StaticResource MaterialDesignCheckBox}">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                        </DataGridCheckBoxColumn>

                        <materialDesign:DataGridTextColumn Binding="{Binding STT}"
                                                           Header="STT"
                                                           IsReadOnly="True" />

                        <materialDesign:DataGridTextColumn Binding="{Binding SubjectName}"
                                                           Header="Tên Môn Học"
                                                           Width="*"
                                                           IsReadOnly="True" />

                        <materialDesign:DataGridTextColumn Binding="{Binding TinChi}"
                                                           Header="Số Tín Chỉ"
                                                           IsReadOnly="True">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Right" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </materialDesign:DataGridTextColumn>

                        <materialDesign:DataGridTextColumn Binding="{Binding GhiChu}"
                                                           Header="Trạng Thái"
                                                           IsReadOnly="True"
                                                           FontStyle="Italic" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
