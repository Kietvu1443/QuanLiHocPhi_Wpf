<Window x:Class="APP_QLHocPhi.SubjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        DataContext="{StaticResource SubjectVM}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        WindowStartupLocation="CenterScreen"
        FontFamily="{materialDesign:MaterialDesignFont}"
        x:Name="window"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Title="Thêm học sinh"
        Height="450"
        Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <uc:UserControlBarUC Tag="{Binding Title, ElementName=window}"></uc:UserControlBarUC>
        </Grid>

        <materialDesign:Card Grid.Row="1"
                             Margin="10"
                             Padding="10">
            <WrapPanel>
                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Mã Môn (VD: IT01)"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Width="150"
                         Margin="5 5 15 5" />

                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tên Môn Học"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Width="250"
                         Margin="5 5 15 5" />
                <TextBox Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                         materialDesign:HintAssist.Hint="Đơn Giá / 1 Tín (VNĐ)"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Width="180"
                         Margin="5 5 15 5" />

                <TextBox Text="{Binding SoTinChi, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Số Tín Chỉ"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Width="100"
                         Margin="5 5 15 5" />
                
            </WrapPanel>
        </materialDesign:Card>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="10">
            <Button Command="{Binding AddCommand}"
                    Content="Thêm"
                    Margin="5"
                    Width="80" />
            <Button Command="{Binding EditCommand}"
                    Content="Sửa"
                    Margin="5"
                    Width="80" />
            <Button Command="{Binding DeleteCommand}"
                    Content="Xóa"
                    Margin="5"
                    Width="80"
                    Background="OrangeRed"
                    BorderBrush="OrangeRed" />
        </StackPanel>

        <materialDesign:Card Grid.Row="3"
                             Margin="10"
                             VerticalAlignment="Stretch">

            <DataGrid ItemsSource="{Binding List}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="All"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                
                <DataGrid.Columns>

                    <materialDesign:DataGridTextColumn Binding="{Binding Id}"
                                                       Header="Mã Môn" />
                    <materialDesign:DataGridTextColumn Binding="{Binding DisplayName}"
                                                       Header="Tên Môn Học"
                                                       Width="100" />
                    <materialDesign:DataGridTextColumn Binding="{Binding SoTinChi}"
                                                       Header="Số TC"
                                                       Width="100" />
                    <materialDesign:DataGridTextColumn Binding="{Binding DonGia, StringFormat={}{0:N0} VNĐ}"
                                                       Header="Đơn Giá/TC"
                                                       Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Window>
