<Window x:Class="APP_QLHocPhi.DashBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        DataContext="{StaticResource DashboardVM}"
        Title="Tông quan"
        x:Name="window"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <uc:UserControlBarUC Tag="{Binding Title, ElementName=window}"></uc:UserControlBarUC>
        </Grid>

        <Grid Grid.Row="1"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0"
                                 Margin="10"
                                 Padding="20"
                                 Background="White"
                                 UniformCornerRadius="10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TỔNG SINH VIÊN ĐANG THEO HỌC"
                                   FontWeight="Bold"
                                   Foreground="Gray" />
                        <materialDesign:PackIcon Kind="AccountMultiple"
                                                 HorizontalAlignment="Right"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="#2196F3" />
                    </Grid>
                    <TextBlock Text="{Binding TotalStudent}"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0 10 0 0" />
                    <TextBlock Text="tổng sinh viên toàn trường"
                               FontSize="12"
                               Foreground="Gray" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1"
                                 Margin="10"
                                 Padding="20"
                                 Background="White"
                                 UniformCornerRadius="10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TỔNG DOANH THU"
                                   FontWeight="Bold"
                                   Foreground="Gray" />
                        <materialDesign:PackIcon Kind="CashMultiple"
                                                 HorizontalAlignment="Right"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="Green" />
                    </Grid>
                    <TextBlock Text="{Binding TongDoanhThu, StringFormat=N0}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="Green"
                               Margin="0 10 0 0" />
                    <TextBlock Text="VNĐ (Tổng tích lũy)"
                               FontSize="12"
                               Foreground="Gray" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                                 Margin="10"
                                 Padding="20"
                                 Background="White"
                                 UniformCornerRadius="10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TỔNG CÔNG NỢ"
                                   FontWeight="Bold"
                                   Foreground="Gray" />
                        <materialDesign:PackIcon Kind="CurrencyUsdOff"
                                                 HorizontalAlignment="Right"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="Red" />
                    </Grid>
                    <TextBlock Text="{Binding TongCongNo, StringFormat=N0}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="Red"
                               Margin="0 10 0 0" />
                    <TextBlock Text="VNĐ (Chưa thu được)"
                               FontSize="12"
                               Foreground="Gray" />
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Card Grid.Row="2"
                             Margin="20 5 20 20"
                             Padding="20"
                             UniformCornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="PHÂN TÍCH TÀI CHÍNH"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Foreground="#333" />
                            <TextBlock Text="So sánh Doanh thu và Công nợ theo kỳ"
                                       FontSize="12"
                                       Foreground="Gray" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Width="150"
                                  ItemsSource="{Binding Semesters}"
                                  SelectedItem="{Binding SelectedSemester}"
                                  materialDesign:HintAssist.Hint="Chọn Học Kỳ"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        </ComboBox>
                    </Grid>

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding SeriesCollection}"
                                        LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Thời gian"
                                      Labels="{Binding Labels}"
                                      FontSize="14">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" />
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Số Tiền (VNĐ)"
                                      LabelFormatter="{Binding Formatter}"
                                      FontSize="12" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="30 0 0 0">
                    <TextBlock Text="Ghi chú:"
                               FontWeight="Bold"
                               TextDecorations="Underline"
                               Margin="0 0 0 15"
                               FontSize="14" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0 5">
                        <Border Width="15"
                                Height="15"
                                Background="#4CAF50"
                                CornerRadius="2"
                                Margin="0 0 10 0" />
                        <TextBlock Text="Đã thu tiền"
                                   Foreground="#4CAF50"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Số tiền thực tế đã thu được trong học kỳ này."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="25 0 0 10" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0 5">
                        <Border Width="15"
                                Height="15"
                                Background="#F44336"
                                CornerRadius="2"
                                Margin="0 0 10 0" />
                        <TextBlock Text="Còn nợ"
                                   Foreground="#F44336"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Số tiền sinh viên chưa đóng trong học kỳ này."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="25 0 0 0" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>