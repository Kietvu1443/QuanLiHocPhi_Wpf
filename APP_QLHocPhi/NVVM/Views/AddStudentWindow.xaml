<Window x:Class="APP_QLHocPhi.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        WindowStartupLocation="CenterScreen"
        DataContext="{StaticResource AddStudentVM}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        x:Name="window"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Title="Thêm học sinh"
        Height="450"
        Width="1000">
    <Grid>
        <materialDesign:PackIcon Kind="AccountSchool"
                                 Width="400"
                                 Height="400"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,-50,-80"
                                 Opacity="0.1"
                                 Foreground="{DynamicResource MaterialDesignBody}">
            <materialDesign:PackIcon.RenderTransform>
                <RotateTransform Angle="-15" />
            </materialDesign:PackIcon.RenderTransform>
        </materialDesign:PackIcon>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <uc:UserControlBarUC Tag="{Binding Title, ElementName=window}"></uc:UserControlBarUC>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>


                <materialDesign:Card Grid.Row="0"
                                     Margin="5">
                    <WrapPanel Margin="0 0 0 10">
                        <TextBox Text="{Binding MSSV}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Mã sinh viên"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Họ và tên"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox Text="{Binding ClassName,UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Lớp"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox Text="{Binding MajorName,UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Ngành"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <ComboBox materialDesign:HintAssist.Hint="Giới Tính"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  Margin="5 5 15 5"
                                  Width="100"
                                  VerticalAlignment="Center"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding GioiTinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                            <ComboBoxItem Content="Nam" />
                            <ComboBoxItem Content="Nữ" />
                            <ComboBoxItem Content="Khác" />

                        </ComboBox>

                        <TextBox Text="{Binding Address,UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Địa chỉ"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox Text="{Binding Phone,UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="SĐT"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 5 15 5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Email"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <ComboBox materialDesign:HintAssist.Hint="Trạng Thái"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  Margin="5 5 15 5"
                                  Width="100"
                                  VerticalAlignment="Center"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding TrangThai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                            <ComboBoxItem Content="Đang học" />
                            <ComboBoxItem Content="Đã nghỉ" />



                        </ComboBox>

                        <DatePicker Width="120"
                                    Margin="5 5 15 5"
                                    SelectedDate="{Binding NgaySinh,UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Ngày Sinh"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1"
                                     Margin="5">
                    <WrapPanel>
                        <Button Command="{Binding AddCommand}"
                                Content="Thêm"
                                Margin="5"
                                Width="100"></Button>
                        <Button Command="{Binding RemoveCommand}"
                                Content="Xoá"
                                Margin="5"
                                Width="100"></Button>
                        <Button Command="{Binding EditCommand}"
                                Content="Sửa"
                                Margin="5"
                                Width="100"></Button>
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2"
                                     HorizontalAlignment="Left"
                                     Width="300"
                                     Margin="5 0 5 5"
                                     Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="Magnify"
                                                 VerticalAlignment="Center"
                                                 Width="25"
                                                 Height="25"
                                                 Foreground="Gray" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Tìm kiếm theo Tên hoặc Mã SV..."
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Margin="10 0 0 0"
                                 BorderThickness="0" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="3"
                                     Margin="5"
                                     VerticalAlignment="Stretch">
                    <DataGrid ItemsSource="{Binding List}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="All"
                              SelectionUnit="FullRow"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                        <DataGrid.Columns>
                            <materialDesign:DataGridTextColumn Binding="{Binding STT}"
                                                               Header="STT"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding Id}"
                                                               Header="Mã SV"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding DisplayName}"
                                                               Header="Họ Tên"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding NgaySinh, StringFormat='dd/MM/yyyy'}"
                                                               Header="Ngày Sinh"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding GioiTinh}"
                                                               Header="Giới Tính"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding Lop}"
                                                               Header="Lớp"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding Nganh}"
                                                               Header="Khoa/Ngành"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding Phone}"
                                                               Header="SĐT"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding Email}"
                                                               Header="Email"
                                                               Width="auto" />

                            <materialDesign:DataGridTextColumn Binding="{Binding Address}"
                                                               Header="Địa Chỉ"
                                                               Width="auto" />
                            <materialDesign:DataGridTextColumn Binding="{Binding TrangThai}"
                                                               Header="Trạng thái"
                                                               Width="auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</Window>