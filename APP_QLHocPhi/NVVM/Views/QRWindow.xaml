<Window x:Class="APP_QLHocPhi.QRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Quét Mã Thanh Toán"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Background="White">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="QUÉT MÃ ĐỂ THANH TOÁN"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="20"
                       Margin="0 0 0 20" />

            <Border BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10">
                <Image x:Name="QrImage"
                       Width="300"
                       Height="300"
                       Stretch="Uniform" />
            </Border>

            <TextBlock Text="Vui lòng kiểm tra kỹ thông tin trước khi chuyển"
                       HorizontalAlignment="Center"
                       FontStyle="Italic"
                       Margin="0 10 0 0" />

            <Button IsCancel="True"
                    Content="Đóng"
                    Margin="0 20 0 0"
                    Width="100" />
        </StackPanel>
    </Grid>
</Window>