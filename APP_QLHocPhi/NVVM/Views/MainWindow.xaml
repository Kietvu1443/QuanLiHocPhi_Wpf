<Window x:Class="APP_QLHocPhi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_QLHocPhi"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        Icon="/Assets/logo.png"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        DataContext="{StaticResource MainVM}"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="Phần mềm quản lí học phí"
        Height="450"
        Width="1000"
        Name="mainWindow">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}"
                                   CommandParameter="{Binding ElementName=mainWindow}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <uc:UserControlBarUC Tag="{Binding Title, ElementName=mainWindow}"></uc:UserControlBarUC>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5">
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Phần mềm quản lí học phí"
                               HorizontalAlignment="Center">
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1"
                      HorizontalAlignment="Center">
                    <WrapPanel Background="Transparent"
                               Orientation="Horizontal"
                               Width="1000"
                               HorizontalAlignment="Center">

                        <WrapPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin"
                                        Value="10 10 10 10"></Setter>
                                <Setter Property="Width"
                                        Value="140"></Setter>
                                <Setter Property="Height"
                                        Value="100"></Setter>
                            </Style>
                        </WrapPanel.Resources>

                        <Button ToolTip="Tổng Quan"
                                Command="{Binding DashBoardCommand}"
                                Visibility="{Binding AdminVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Tổng Quan"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="ViewDashboard" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Quản lí Học Sinh"
                                Command="{Binding AddStudentCommand}"
                                Visibility="{Binding AdminVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Text="Quản lí học Sinh"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Kind="AccountSchool" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Quản Lí Học Phí"
                                Command="{Binding SchoolFeeCommand}"
                                Visibility="{Binding AdminVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Quản lí học Phí"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="CashMultiple" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Quản lí môn học"
                                Command="{Binding SubjectCommand}"
                                Visibility="{Binding AdminVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Quản lí môn học"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="Bookshelf" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Thông tin học sinh"
                                Command="{Binding StudentCommand}"
                                Visibility="{Binding StudentVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Thông tin &amp; Đăng ký"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"></TextBlock>
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="AccountBox" />
                            </Grid>
                        </Button>

                        <Button ToolTip="Xem hóa đơn của tôi"
                                Command="{Binding StudentInvoiceCommand}"
                                Visibility="{Binding StudentVisibility}"
                                Background="#FF4CAF50"
                                BorderBrush="#FF4CAF50">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Hóa đơn của tôi"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <materialDesign:PackIcon Grid.Row="1"
                                                         HorizontalAlignment="Center"
                                                         Kind="ReceiptTextCheck" />
                            </Grid>
                        </Button>

                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>