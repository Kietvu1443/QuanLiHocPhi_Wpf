<Window x:Class="APP_QLHocPhi.StudentInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:APP_QLHocPhi.UserControlSF"
        mc:Ignorable="d"
        Name="studentInvoiceWd"
        Title="Tra cứu hóa đơn"
        Height="450"
        Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="770" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <uc:UserControlBarUC Tag="{Binding Title, ElementName=window}"></uc:UserControlBarUC>
        </Grid>

        <Grid Grid.Row="1"
              Background="{DynamicResource PrimaryHueMidBrush}"
              Height="40">
            <StackPanel Orientation="Horizontal"
                        Margin="10 0">
                <materialDesign:PackIcon Kind="ReceiptTextCheck"
                                         VerticalAlignment="Center"
                                         Foreground="Black"
                                         Width="25"
                                         Height="25" />
                <TextBlock Text="TRA CỨU &amp; IN HÓA ĐƠN"
                           VerticalAlignment="Center"
                           Margin="10 0"
                           Foreground="Black"
                           FontWeight="Bold"
                           FontSize="16" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    CommandParameter="{Binding ElementName=studentInvoiceWd}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                    Foreground="White"
                    ToolTip="Đóng">
                <materialDesign:PackIcon Kind="Close" />
            </Button>
        </Grid>

        <materialDesign:Card Grid.Row="2"
                             Margin="20"
                             Padding="15"
                             UniformCornerRadius="10"
                             >
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountSearch"
                                         VerticalAlignment="Bottom"
                                         Margin="0 0 10 5"
                                         Width="30"
                                         Height="30"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="350"
                         FontSize="16"
                         materialDesign:HintAssist.Hint="Nhập tên hoặc MSSV để tìm..."
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0 0 20 0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Command="{Binding SearchCommand}"
                        Content="TÌM KIẾM"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Width="120"
                        ToolTip="Bấm để tìm" />
            </StackPanel>
        </materialDesign:Card>

        <DataGrid Grid.Row="3"
                  Margin="10 0 10 10"
                  ItemsSource="{Binding ListInvoices}"
                  SelectedItem="{Binding SelectedInvoice}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số HĐ"
                                    Binding="{Binding Id}"
                                    Width="80" />
                <DataGridTextColumn Header="MSSV"
                                    Binding="{Binding StudentId}"
                                    Width="100" />
                <DataGridTextColumn Header="Họ Tên"
                                    Binding="{Binding Student.DisplayName}"
                                    Width="*" />
                <DataGridTextColumn Header="Ngày Thu"
                                    Binding="{Binding NgayThu, StringFormat='dd/MM/yyyy'}"
                                    Width="120" />
                <DataGridTextColumn Header="Học Kỳ"
                                    Binding="{Binding HocKy}"
                                    Width="100" />
                <DataGridTextColumn Header="Số Tiền"
                                    Binding="{Binding TongTienThu, StringFormat='N0'}"
                                    Width="120"
                                    FontWeight="Bold"
                                    Foreground="DarkRed" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4"
              Margin="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="Chọn hóa đơn để in ấn"
                           VerticalAlignment="Center"
                           Margin="0 0 15 0"
                           FontStyle="Italic"
                           Opacity="0.7" />

                <Button Command="{Binding PrintCommand}"
                        Content="IN HÓA ĐƠN"
                        Width="160"
                        Height="45"
                        FontSize="16"
                        Background="#4CAF50"
                        BorderBrush="#4CAF50"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer"
                                                         Margin="0 0 8 0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="IN HÓA ĐƠN" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>