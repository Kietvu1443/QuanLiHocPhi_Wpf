<UserControl x:Class="APP_QLHocPhi.InvoiceTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="500"
             Background="White">
    <Border BorderBrush="Black"
            BorderThickness="2"
            Margin="10"
            Padding="20">
        <StackPanel>
            <TextBlock Text="TRƯỜNG ĐẠI HỌC"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="16" />
            <TextBlock Text="Địc chỉ: Bình Dương"
                       HorizontalAlignment="Center"
                       FontStyle="Italic"
                       FontSize="12" />

            <TextBlock Text="PHIẾU THU HỌC PHÍ"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       Margin="0 20" />

            <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Họ tên SV:"
                           FontWeight="Bold"
                           Margin="0 5 10 5" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           x:Name="txbTenSV"
                           Text="Nguyễn Văn A"
                           Margin="0 5" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Mã số SV:"
                           FontWeight="Bold"
                           Margin="0 5 10 5" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           x:Name="txbMSSV"
                           Text="12345678"
                           Margin="0 5" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Lớp:"
                           FontWeight="Bold"
                           Margin="0 5 10 5" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           x:Name="txbLop"
                           Text="CNTT K18"
                           Margin="0 5" />
            </Grid>

            <Separator Background="Black" />

            <Grid Margin="0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Số tiền thu:"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0 5 10 5" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           x:Name="txbSoTien"
                           Text="5,000,000 VNĐ"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="0 5" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Nội dung:"
                           FontWeight="Bold"
                           Margin="0 5 10 5" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           x:Name="txbNoiDung"
                           Text="Thu học phí HK1"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Right"
                           Margin="0 5" />
            </Grid>

            <Separator Background="Black" />

            <TextBlock x:Name="txbNgayThu"
                       Text="Ngày ... tháng ... năm 20..."
                       HorizontalAlignment="Right"
                       FontStyle="Italic"
                       Margin="0 10" />

            <Grid Margin="0 20 0 50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Người nộp tiền"
                           HorizontalAlignment="Center"
                           FontWeight="Bold" />
                <TextBlock Grid.Column="1"
                           Text="Người thu tiền"
                           HorizontalAlignment="Center"
                           FontWeight="Bold" />
            </Grid>

            <TextBlock Text="(Ký, ghi rõ họ tên)"
                       HorizontalAlignment="Center"
                       FontStyle="Italic"
                       Opacity="0.6" />
        </StackPanel>
    </Border>
</UserControl>