<Window x:Class="APP_QLHocPhi.StudentInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Name="studentInvoiceWindow"
        Title="Tra cứu hóa đơn"
        Height="600"
        Width="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{DynamicResource PrimaryHueMidBrush}"
              Height="40"
              MouseDown="Grid_MouseDown">
            <TextBlock Text="TRA CỨU &amp; IN HÓA ĐƠN"
                       VerticalAlignment="Center"
                       Margin="15 0"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="16" />
            <Button Command="{Binding CloseCommand}"
                    CommandParameter="{Binding ElementName=studentInvoiceWindow}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                    Foreground="White"
                    ToolTip="Đóng">
                <materialDesign:PackIcon Kind="Close" />
            </Button>
        </Grid>

        <materialDesign:Card Grid.Row="1"
                             Margin="10"
                             Padding="10"
                             UniformCornerRadius="5">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountSearch"
                                         VerticalAlignment="Bottom"
                                         Margin="0 0 10 10"
                                         Width="25"
                                         Height="25" />

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="300"
                         materialDesign:HintAssist.Hint="Nhập tên hoặc MSSV..."
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="16"
                         Margin="0 0 20 0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Command="{Binding SearchCommand}"
                        Content="TÌM KIẾM"
                        Width="120"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        ToolTip="Tìm hóa đơn" />
            </StackPanel>
        </materialDesign:Card>

        <DataGrid Grid.Row="2"
                  Margin="10"
                  ItemsSource="{Binding ListInvoices}"
                  SelectedItem="{Binding SelectedInvoice}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Hóa Đơn"
                                    Binding="{Binding Id}"
                                    Width="80" />
                <DataGridTextColumn Header="Mã SV"
                                    Binding="{Binding StudentId}"
                                    Width="100" />
                <DataGridTextColumn Header="Họ Tên"
                                    Binding="{Binding Student.DisplayName}"
                                    Width="*" />
                <DataGridTextColumn Header="Ngày Thu"
                                    Binding="{Binding NgayThu, StringFormat='dd/MM/yyyy'}"
                                    Width="120" />
                <DataGridTextColumn Header="Học Kỳ"
                                    Binding="{Binding HocKy}"
                                    Width="120" />
                <DataGridTextColumn Header="Tổng Tiền"
                                    Binding="{Binding TongTienThu, StringFormat='N0'}"
                                    Width="120"
                                    FontWeight="Bold" />

                <DataGridTemplateColumn Header="Chi tiết">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="Eye"
                                                     HorizontalAlignment="Center"
                                                     Foreground="Gray" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3"
              Margin="10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="Chọn một hóa đơn để in"
                           VerticalAlignment="Center"
                           Margin="0 0 10 0"
                           FontStyle="Italic"
                           Visibility="{Binding SelectedInvoice, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}" />

                <Button Command="{Binding PrintCommand}"
                        
                        Width="150"
                        Height="40"
                        Style="{StaticResource MaterialDesignRaisedAccentButton}"
                        IsEnabled="{Binding SelectedInvoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Printer"
                                                 Margin="0 0 8 0"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="IN HÓA ĐƠN" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>